# ==============================================================================
# LawBuddy Environment Configuration Template
# Copy to .env and adjust paths/keys for your local setup.
# ==============================================================================

# --- LawBuddy Root & Storage ---
# Base directory for LawBuddy data (leave empty to default to repo root or set path)
LEGAL_ROOT=
LEGAL_DB_PATH=.lawbuddy/lawbuddy.db
LEGAL_RAW_DIR=.lawbuddy/raw

# --- Python Worker Environment ---
# Path to python in virtual environment containing workers/requirements.txt
LEGAL_PYTHON=workers/.venv/bin/python
LEGAL_PDF_WORKER=workers/pdf_extract.py
LEGAL_TEXT_WORKER=workers/pdf_text.py
LEGAL_PDF_TIMEOUT_MS=300000

# --- Statutory Fetcher & Ingestion ---
LEGAL_USER_AGENT="LawBuddyBot/0.1 (+educational legal research)"
LEGAL_FETCH_MIN_INTERVAL_MS=3000
LEGAL_FETCH_TIMEOUT_MS=30000
LEGAL_FETCH_MAX_BYTES=52428800

# --- LLM Providers & Statutory Grounding (Groq) ---
GROQ_API_KEY=
LEGAL_BRIEF_MODEL=openai/gpt-oss-120b
LEGAL_ANSWER_MODEL=openai/gpt-oss-120b
LEGAL_CRITIC_MODEL=openai/gpt-oss-120b

# --- Local Development & Serving ---
PORT=3020
DOCVEX_DIR=../DOCVEX
CHATTERBOX_ENABLED=false

# --- Companion DocVex Server Defaults ---
DEFAULT_PROVIDER=hybrid
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
MAX_SELECTION_LENGTH=12000
RETRIEVAL_TIMEOUT_MS=2500
