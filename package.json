{
  "name": "@docvex/lawbuddy",
  "version": "0.1.0",
  "description": "LawBuddy — Voice-first legal tutor with verified statutory grounding",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.js",
    "lint": "find src web -name '*.js' -type f -print0 | xargs -0 -n 1 node --check",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "serve dist -l 4173"
  },
  "keywords": [
    "legal-ai",
    "statutory-grounding",
    "constitution-of-india",
    "speech-synthesis"
  ],
  "author": "",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./web/*": "./web/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "workers",
    "docs",
    "README.md"
  ],
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
